# Copy to .env and fill in. Never commit .env.
# Real environment variables override values in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

MLFLOW_TRACKING_URI=http://127.0.0.1:5000

AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=

# Optional: require header X-Agent-Token on the agent API
AGENT_API_TOKEN=

# Optional: kubeconfig context to use (default: current context)
KUBE_CONTEXT=